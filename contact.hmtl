<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EduLearn - Contact & Help</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f6f9;
            color: #222;
        }

        /* NAVBAR */

        .navbar {
            background: #1e3a8a;
            color: white;

            padding: 18px 40px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 20px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            font-size: 15px;
        }

        .nav-links a:hover {
            text-decoration: underline;
        }


        /* MAIN */

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 40px auto;
        }


        /* HEADER */

        .page-header {
            background: white;

            padding: 35px;

            border-radius: 12px;

            margin-bottom: 25px;

            text-align: center;

            box-shadow:
                0 3px 10px rgba(0,0,0,0.08);
        }

        .page-header h1 {
            color: #1e3a8a;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
            line-height: 1.6;
        }


        /* SUPPORT CARDS */

        .support-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;

            margin-bottom: 25px;
        }

        .support-card {
            background: white;

            padding: 25px;

            border-radius: 12px;

            text-align: center;

            box-shadow:
                0 3px 10px rgba(0,0,0,0.08);
        }

        .support-icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .support-card h3 {
            color: #1e3a8a;
            margin-bottom: 8px;
        }

        .support-card p {
            color: #666;
            font-size: 14px;
            line-height: 1.5;
        }


        /* CONTENT GRID */

        .content-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 25px;

            align-items: start;
        }


        /* FAQ */

        .faq {

            background: white;

            padding: 30px;

            border-radius: 12px;

            box-shadow:
                0 3px 10px rgba(0,0,0,0.08);
        }

        .faq h2 {

            color: #1e3a8a;

            margin-bottom: 20px;
        }

        .faq-item {

            padding: 18px 0;

            border-bottom: 1px solid #eee;
        }

        .faq-item:last-child {

            border-bottom: none;
        }

        .faq-item h3 {

            font-size: 15px;

            margin-bottom: 8px;
        }

        .faq-item p {

            color: #666;

            font-size: 14px;

            line-height: 1.6;
        }


        /* CONTACT FORM */

        .contact-form {

            background: white;

            padding: 30px;

            border-radius: 12px;

            box-shadow:
                0 3px 10px rgba(0,0,0,0.08);
        }

        .contact-form h2 {

            color: #1e3a8a;

            margin-bottom: 20px;
        }

        .form-group {

            margin-bottom: 18px;
        }

        .form-group label {

            display: block;

            font-size: 14px;

            margin-bottom: 7px;

            font-weight: bold;
        }

        .form-group input,
        .form-group textarea {

            width: 100%;

            padding: 11px;

            border: 1px solid #ccc;

            border-radius: 6px;

            font-size: 14px;

            outline: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {

            border-color: #1e3a8a;
        }

        .form-group textarea {

            height: 130px;

            resize: vertical;
        }


        /* BUTTON */

        .submit-button {

            width: 100%;

            padding: 12px;

            border: none;

            border-radius: 6px;

            background: #1e3a8a;

            color: white;

            font-size: 15px;

            cursor: pointer;
        }

        .submit-button:hover {

            background: #162d6b;
        }


        /* MESSAGE */

        #formMessage {

            display: none;

            margin-top: 15px;

            padding: 12px;

            border-radius: 6px;

            background: #e8eefc;

            color: #1e3a8a;

            font-size: 14px;

            text-align: center;
        }


        /* FOOTER */

        .footer {

            background: #1e3a8a;

            color: white;

            text-align: center;

            padding: 25px;

            margin-top: 40px;
        }

        .footer p {

            font-size: 14px;
        }


        /* RESPONSIVE */

        @media (max-width: 800px) {

            .support-grid {

                grid-template-columns: 1fr;
            }

            .content-grid {

                grid-template-columns: 1fr;
            }

            .navbar {

                padding: 15px 20px;
            }

        }


        @media (max-width: 600px) {

            .nav-links {

                display: none;
            }

            .container {

                width: 94%;
            }

        }

    </style>

</head>


<body>


    <!-- NAVIGATION -->

    <nav class="navbar">

        <div class="logo">
            EduLearn
        </div>


        <div class="nav-links">

            <a href="index.html">
                Home
            </a>

            <a href="dashboard.html">
                Dashboard
            </a>

            <a href="courses.html">
                Courses
            </a>

            <a href="profile.html">
                Profile
            </a>

            <a href="settings.html">
                Settings
            </a>

        </div>

    </nav>



    <!-- MAIN -->

    <main class="container">


        <!-- HEADER -->

        <section class="page-header">

            <h1>
                Contact & Help
            </h1>

            <p>
                Need help with EduLearn? Find answers to common
                questions or send us a message.
            </p>

        </section>



        <!-- SUPPORT OPTIONS -->

        <section class="support-grid">


            <div class="support-card">

                <div class="support-icon">
                    ❓
                </div>

                <h3>
                    Help Center
                </h3>

                <p>
                    Find answers to common questions about
                    using EduLearn.
                </p>

            </div>


            <div class="support-card">

                <div class="support-icon">
                    📧
                </div>

                <h3>
                    Email Support
                </h3>

                <p>
                    Contact the EduLearn support team
                    for assistance.
                </p>

            </div>


            <div class="support-card">

                <div class="support-icon">
                    💬
                </div>

                <h3>
                    Student Support
                </h3>

                <p>
                    Get assistance with courses,
                    lessons and assessments.
                </p>

            </div>


        </section>



        <!-- FAQ + FORM -->

        <section class="content-grid">


            <!-- FAQ -->

            <div class="faq">

                <h2>
                    Frequently Asked Questions
                </h2>


                <div class="faq-item">

                    <h3>
                        How do I start a course?
                    </h3>

                    <p>
                        Open the Courses page and select an available
                        course to begin learning.
                    </p>

                </div>


                <div class="faq-item">

                    <h3>
                        How is my progress saved?
                    </h3>

                    <p>
                        Your lesson completion and learning progress
                        are saved automatically in your browser.
                    </p>

                </div>


                <div class="faq-item">

                    <h3>
                        Can I retake an assessment?
                    </h3>

                    <p>
                        Assessment options can be expanded as
                        EduLearn develops further.
                    </p>

                </div>


                <div class="faq-item">

                    <h3>
                        Will more courses be added?
                    </h3>

                    <p>
                        Yes. EduLearn is designed to support
                        multiple college-level subjects.
                    </p>

                </div>

            </div>



            <!-- CONTACT FORM -->

            <div class="contact-form">

                <h2>
                    Send a Message
                </h2>


                <form id="contactForm">


                    <div class="form-group">

                        <label for="name">
                            Name
                        </label>

                        <input
                            type="text"
                            id="name"
                            placeholder="Enter your name"
                            required>

                    </div>


                    <div class="form-group">

                        <label for="email">
                            Email
                        </label>

                        <input
                            type="email"
                            id="email"
                            placeholder="Enter your email"
                            required>

                    </div>


                    <div class="form-group">

                        <label for="message">
                            Message
                        </label>

                        <textarea
                            id="message"
                            placeholder="Describe your question or problem"
                            required></textarea>

                    </div>


                    <button
                        type="submit"
                        class="submit-button">

                        Send Message

                    </button>


                </form>


                <div id="formMessage">

                    Thank you! Your message has been received.

                </div>

            </div>


        </section>


    </main>



    <!-- FOOTER -->

    <footer class="footer">

        <p>
            © 2026 EduLearn. All rights reserved.
        </p>

    </footer>



    <!-- JAVASCRIPT -->

    <script>

        const contactForm =
            document.getElementById(
                "contactForm"
            );


        contactForm.addEventListener(
            "submit",
            function(event) {

                event.preventDefault();


                document.getElementById(
                    "formMessage"
                ).style.display =
                    "block";


                contactForm.reset();

            }
        );

    </script>


</body>

</html>
